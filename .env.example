# Copy this file to .env.local. Next.js loads .env.local and it is gitignored.
# Every value below is a placeholder, not a real secret.
#
# Enhance and Ask need one credential: ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN,
# or an ANTHROPIC_PROFILE from `ant auth login`. The notepad, transcription,
# folders, calendar, and sharing work with all of these left unset.
# Get a key at https://console.anthropic.com/
#
# If ANTHROPIC_API_KEY and ANTHROPIC_AUTH_TOKEN are both non-empty, the SDK
# uses ANTHROPIC_API_KEY.

# Primary credential. Read by the Anthropic client and by Settings.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Alternative credential. Settings treats a non-empty value as a configured key.
# Clear this when ANTHROPIC_API_KEY is set.
ANTHROPIC_AUTH_TOKEN=your-anthropic-auth-token

# Optional profile name used only when both credentials above are empty.
# Placeholder for a profile created by `ant auth login`. Clear it if you do not use one.
ANTHROPIC_PROFILE=your-profile-name

# Optional API host. This placeholder is the SDK default.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model used for Enhance and Ask. This placeholder is the built-in default.
FROSTEDFLAKES_MODEL=claude-opus-5-5

# Directory for the local JSON database (data/db.json). This placeholder is the built-in default.
FROSTEDFLAKES_DATA_DIR=./data
